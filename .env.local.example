# Copy this file to .env.local and fill in your real values.
# .env.local is already gitignored — never commit real keys.
# See SETUP.md for step-by-step instructions on obtaining each value.

# ── Supabase ────────────────────────────────────────────────────────────
# Project Settings → API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Reserved for a future authenticated admin dashboard — no route in this
# codebase uses it today. Server-only: never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── Contact / external links ───────────────────────────────────────────
# WhatsApp Business number, digits only (country code, no +/spaces/dashes).
NEXT_PUBLIC_WHATSAPP_NUMBER=917200001934

# Shaash Beauty Store — external site the "Shaash Beauty Store" card links to.
NEXT_PUBLIC_SHAASH_STORE_URL=https://shaash-extension.vercel.app/

# Instagram links (footer / social references).
NEXT_PUBLIC_INSTAGRAM_MAIN=https://www.instagram.com/the_couple_artistry
NEXT_PUBLIC_INSTAGRAM_STORE=https://www.instagram.com/shaash.beautystore
NEXT_PUBLIC_INSTAGRAM_STITCHING=https://www.instagram.com/shaash_bridal_designer_studio

# Google Business review link (placeholder-testimonials source for now).
NEXT_PUBLIC_GOOGLE_REVIEW_URL=https://share.google/EUAbcsd5vH12nTZO6

# Canonical site URL — used for metadata/OG tags and the sitemap.
# Set this to your real Vercel URL (or custom domain) once deployed.
NEXT_PUBLIC_SITE_URL=https://couple-artistry-website.vercel.app

# ── Google Calendar (real availability lookups) ────────────────────────
# Optional — leave all three blank and availability/slot checks keep running
# on the deterministic stub they use today. Once all three are set, real
# checks kick in automatically with no other code change. See SETUP.md §8.
# Server-only: never prefix any of these with NEXT_PUBLIC_.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private key exactly as it appears in the downloaded JSON key,
# literal \n characters included — the code un-escapes them at runtime.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# From the shared calendar's Settings and sharing → Integrate calendar.
GOOGLE_CALENDAR_ID=
